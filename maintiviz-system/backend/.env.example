# ──────────────────────────────────────────────────────────────────────────────
# MaintiViz Edge Engine — Backend Environment Variables
# Copy this file to `.env` and fill in your values before starting the server.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Replace with your Atlas connection string or use a local MongoDB URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/maintiviz?retryWrites=true&w=majority

# ── ML Microservice ────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=8000

# ── Frontend CORS origin ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
